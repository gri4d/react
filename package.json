    "build": "node ./esbuild.prod.mjs",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@gri4d/griiiid": "^1.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  }
}
